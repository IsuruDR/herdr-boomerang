{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"]
}
