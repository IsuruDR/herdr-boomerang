{
  "name": "herdr-boomerang",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "HOME=\"$(mktemp -d -t boomerang-test-home)\" node --no-warnings --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm test --silent && tsc --noEmit && biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
